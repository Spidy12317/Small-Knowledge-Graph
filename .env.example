# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Azure OpenAI GPT-5
AZURE_OPENAI_GPT5_ENDPOINT=
AZURE_OPENAI_GPT5_KEY=
AZURE_OPENAI_GPT5_DEPLOYMENT=
AZURE_OPENAI_GPT5_API_VERSION=2024-12-01-preview

# Shared
LLM_TEMPERATURE=0
MAX_CONCURRENT=8

# Graph
GRAPH_MAX_ROOT_CHILDREN=4
GRAPH_MAX_NODE_CHILDREN=8
GRAPH_MAX_CONCURRENT_EVALUATIONS=1
GRAPH_HIGH_CONFIDENCE_SCORE_THRESHOLD=0.70
GRAPH_MAX_CONCURRENT_INSERTIONS=4

# Database
POSTGRES_HOST="localhost"
POSTGRES_DB="skg"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_PORT="5432"
POSTGRES_SSLMODE=false
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=15000
DATABASE_ECHO=false

# Telemetry (OpenTelemetry)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=skg
OTEL_TRACES_FILE=data/traces.jsonl
OTEL_MAX_CONTENT_LENGTH=100000